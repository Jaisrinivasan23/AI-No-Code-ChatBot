{% extends "base.html" %}

{% block extra_head %}
    <title>{{ user.username }}'s Dashboard | AI Chatbot Platform</title>
    <style>        
        /* Dashboard specific styles */
        .welcome-section {
            background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 50%, #06b6d4 100%);
            border-radius: var(--card-border-radius);
            padding: 2.5rem 2rem;
            color: white;
            position: relative;
            overflow: hidden;
            margin-bottom: 2.5rem;
            box-shadow: var(--card-shadow);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }
        
        .welcome-section::before {
            content: '';
            position: absolute;
            top: -50px;
            right: -50px;
            width: 250px;
            height: 250px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.1);
            z-index: 1;
            animation: pulse 8s infinite alternate;
        }
        
        .welcome-section::after {
            content: '';
            position: absolute;
            bottom: -80px;
            left: -80px;
            width: 350px;
            height: 350px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.05);
            z-index: 1;
            animation: pulse 12s infinite alternate-reverse;
        }
        
        @keyframes pulse {
            0% { transform: scale(1); opacity: 0.05; }
            50% { transform: scale(1.05); opacity: 0.1; }
            100% { transform: scale(1); opacity: 0.05; }
        }
        
        .welcome-content {
            position: relative;
            z-index: 2;
        }
        
        .welcome-avatar {
            width: 65px;
            height: 65px;
            border-radius: 50%;
            background: white;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
            border: 3px solid rgba(255, 255, 255, 0.7);
            position: relative;
            overflow: hidden;
        }
        
        .welcome-avatar i {
            background-image: linear-gradient(135deg, #4f46e5, #06b6d4);
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
            font-size: 2rem;
        }
        
        .welcome-section .btn-light {
            border: none;
            background: rgba(255, 255, 255, 0.9);
            box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
            transition: all 0.3s ease;
            color: var(--primary-color);
            font-weight: 600;
            padding: 0.8rem 1.5rem;
        }
        
        .welcome-section .btn-light:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 20px rgba(0, 0, 0, 0.15);
            background: white;
        }
        
        .bg-pattern {
            background-color: var(--light-bg);
            background-image: url("data:image/svg+xml,%3Csvg width='100' height='100' viewBox='0 0 100 100' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M11 18c3.866 0 7-3.134 7-7s-3.134-7-7-7-7 3.134-7 7 3.134 7 7 7zm48 25c3.866 0 7-3.134 7-7s-3.134-7-7-7-7 3.134-7 7 3.134 7 7 7zm-43-7c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zm63 31c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zM34 90c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zm56-76c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zM12 86c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm28-65c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm23-11c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zm-6 60c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm29 22c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zM32 63c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zm57-13c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zm-9-21c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2zM60 91c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2zM35 41c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2zM12 60c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2z' fill='%239C92AC' fill-opacity='0.05' fill-rule='evenodd'/%3E%3C/svg%3E");
        }
        
        .stats-container {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            gap: 1.5rem;
            margin-bottom: 2.5rem;
        }
        
        .stat-card {
            background: white;
            border-radius: var(--card-border-radius);
            padding: 1.8rem;
            box-shadow: var(--card-shadow);
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            border: 1px solid rgba(0, 0, 0, 0.05);
            position: relative;
            overflow: hidden;
        }
        
        .stat-card::after {
            content: '';
            position: absolute;
            width: 100%;
            height: 100%;
            top: 0;
            left: 0;
            background: linear-gradient(45deg, rgba(255,255,255,0.2) 0%, rgba(255,255,255,0) 70%);
            pointer-events: none;
        }
        
        .stat-card:hover {
            transform: translateY(-8px) scale(1.02);
            box-shadow: var(--heavy-shadow);
        }
        
        .stat-icon {
            width: 65px;
            height: 65px;
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.6rem;
            margin-bottom: 1.2rem;
            box-shadow: 0 5px 10px rgba(0, 0, 0, 0.05);
            position: relative;
            overflow: hidden;
        }
        
        .stat-icon::after {
            content: '';
            position: absolute;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, rgba(255,255,255,0.25) 0%, rgba(255,255,255,0) 80%);
            top: 0;
            left: 0;
        }
        
        .stat-value {
            font-size: 2.2rem;
            font-weight: 700;
            margin-bottom: 0.5rem;
            background-image: linear-gradient(90deg, #000, #333);
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        
        .stat-label {
            color: var(--medium-text);
            font-size: 1.1rem;
            letter-spacing: 0.5px;
            font-weight: 500;
        }
          .chatbot-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
            gap: 1.8rem;
        }
        
        .chatbot-card {
            background: white;
            border-radius: var(--card-border-radius);
            box-shadow: var(--card-shadow);
            overflow: hidden;
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            position: relative;
            height: 100%;
            border: 1px solid rgba(0, 0, 0, 0.05);
        }
        
        .chatbot-card:hover {
            transform: translateY(-8px) scale(1.01);
            box-shadow: var(--heavy-shadow);
        }
        
        .chatbot-card::after {
            content: '';
            position: absolute;
            width: 100%;
            height: 8px;
            top: 0;
            left: 0;
            background: linear-gradient(90deg, var(--primary-color), var(--secondary-color));
            opacity: 0;
            transition: all 0.3s ease;
        }
        
        .chatbot-card:hover::after {
            opacity: 1;
        }
        
        .chatbot-header {
            padding: 1.6rem;
            border-bottom: 1px solid var(--light-border);
            display: flex;
            align-items: center;
            background: linear-gradient(to bottom, rgba(249, 250, 251, 0.7), rgba(255, 255, 255, 1));
        }
        
        .chatbot-body {
            padding: 1.6rem;
            position: relative;
        }
        
        .chatbot-body::before {
            content: '';
            position: absolute;
            width: 150px;
            height: 150px;
            border-radius: 50%;
            background: radial-gradient(rgba(79, 70, 229, 0.03), transparent);
            bottom: -50px;
            right: -50px;
            z-index: 0;
        }
        
        .chatbot-icon {
            width: 54px;
            height: 54px;
            border-radius: 16px;
            background: rgba(79, 70, 229, 0.1);
            color: var(--primary-color);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.6rem;
            margin-right: 1.2rem;
            box-shadow: 0 4px 10px rgba(79, 70, 229, 0.15);
            position: relative;
            overflow: hidden;
            transition: all 0.3s ease;
        }
        
        .chatbot-card:hover .chatbot-icon {
            transform: scale(1.05) rotate(5deg);
            box-shadow: 0 6px 15px rgba(79, 70, 229, 0.25);
        }
        
        .chatbot-icon::after {
            content: '';
            position: absolute;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, rgba(255,255,255,0.3) 0%, rgba(255,255,255,0) 80%);
            top: 0;
            left: 0;
        }
        
        .chatbot-title {
            font-weight: 700;
            margin-bottom: 0.25rem;
            font-size: 1.2rem;
            color: var(--dark-text);
            transition: all 0.3s ease;
        }
        
        .chatbot-card:hover .chatbot-title {
            color: var(--primary-color);
        }
        
        .chatbot-type {
            color: var(--medium-text);
            font-size: 0.875rem;
            display: inline-block;
            padding: 0.2rem 0.5rem;
            background: var(--light-input-bg);
            border-radius: 20px;
            font-weight: 500;
        }
        
        .chatbot-stats {
            display: flex;
            margin-bottom: 1.5rem;
        }
        
        .chatbot-stat {
            flex: 1;
            text-align: center;
            padding: 0.85rem;
            background: var(--light-input-bg);
            border-radius: 12px;
            margin-right: 0.7rem;
            transition: all 0.3s ease;
            border: 1px solid transparent;
            position: relative;
            z-index: 1;
        }
        
        .chatbot-stat:last-child {
            margin-right: 0;
        }
        
        .chatbot-card:hover .chatbot-stat {
            background: rgba(79, 70, 229, 0.08);
            border-color: rgba(79, 70, 229, 0.15);
            transform: translateY(-2px);
        }
        
        .chatbot-stat-value {
            font-weight: 700;
            font-size: 1.6rem;
            margin-bottom: 0.3rem;
            background-image: linear-gradient(90deg, var(--primary-color), var(--secondary-color));
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        
        .chatbot-stat-label {
            color: var(--medium-text);
            font-size: 0.75rem;
            font-weight: 600;
            letter-spacing: 0.5px;
        }
        
        .chatbot-actions {
            display: flex;
            gap: 0.8rem;
            position: relative;
            z-index: 1;
        }
        
        .chatbot-actions .btn {
            padding: 0.7rem 1rem;
            transition: all 0.3s ease;
            font-weight: 600;
            letter-spacing: 0.3px;
        }
        
        .chatbot-actions .btn:hover {
            transform: translateY(-3px);
        }
        
        .chatbot-actions .btn i {
            transition: all 0.3s ease;
        }
        
        .chatbot-actions .btn:hover i {
            transform: scale(1.2);
        }
        
        .filter-card {
            background: white;
            border-radius: var(--card-border-radius);
            padding: 1.8rem;
            box-shadow: var(--card-shadow);
            margin-bottom: 2.5rem;
            border: 1px solid rgba(0, 0, 0, 0.05);
            position: relative;
            overflow: hidden;
        }
        
        .filter-card::after {
            content: '';
            position: absolute;
            width: 150px;
            height: 150px;
            border-radius: 50%;
            background: radial-gradient(rgba(79, 70, 229, 0.03), transparent);
            bottom: -50px;
            right: -50px;
            z-index: 0;
        }
        
        .filter-inputs {
            display: flex;
            flex-wrap: wrap;
            gap: 1.2rem;
            position: relative;
            z-index: 1;
        }
        
        .filter-item {
            flex: 1;
            min-width: 220px;
        }
        
        .filter-item .form-label {
            font-weight: 600;
            margin-bottom: 0.5rem;
            color: var(--medium-text);
        }
        
        .filter-item .form-select,
        .filter-item .form-control {
            border-radius: 10px;
            padding: 0.7rem 1rem;
            font-weight: 500;
            transition: all 0.3s ease;
        }
        
        .filter-item .form-select:focus,
        .filter-item .form-control:focus {
            border-color: var(--primary-color);
            box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.2);
        }
        
        .input-group-text {
            border-radius: 10px 0 0 10px;
            transition: all 0.3s ease;
        }
        
        .empty-state {
            text-align: center;
            padding: 4rem 1.5rem;
            background: white;
            border-radius: var(--card-border-radius);
            box-shadow: var(--card-shadow);
            position: relative;
            overflow: hidden;
        }
        
        .empty-state::after {
            content: '';
            position: absolute;
            width: 100%;
            height: 8px;
            top: 0;
            left: 0;
            background: linear-gradient(90deg, var(--primary-color), var(--secondary-color), var(--accent-color));
        }
        
        .empty-icon {
            font-size: 5rem;
            color: #e2e8f0;
            margin-bottom: 1.8rem;
            background: linear-gradient(135deg, var(--light-border), #e2e8f0);
            width: 120px;
            height: 120px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            margin: 0 auto 2rem;
        }
          /* Animation for cards and elements */
        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translate3d(0, 30px, 0);
            }
            to {
                opacity: 1;
                transform: translate3d(0, 0, 0);
            }
        }
        
        @keyframes float {
            0% {
                transform: translateY(0px);
            }
            50% {
                transform: translateY(-10px);
            }
            100% {
                transform: translateY(0px);
            }
        }
        
        @keyframes pulse-shadow {
            0% {
                box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
            }
            50% {
                box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
            }
            100% {
                box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
            }
        }
        
        @keyframes gradient-shift {
            0% {
                background-position: 0% 50%;
            }
            50% {
                background-position: 100% 50%;
            }
            100% {
                background-position: 0% 50%;
            }
        }
        
        .animate-fade-in-up {
            animation: fadeInUp 0.5s ease forwards;
        }
        
        .animate-float {
            animation: float 6s ease-in-out infinite;
        }
        
        .animate-pulse-shadow {
            animation: pulse-shadow 3s ease-in-out infinite;
        }
        
        .animate-gradient {
            background-size: 200% 200%;
            animation: gradient-shift 8s ease infinite;
        }
        
        /* Spotlight hover effect */
        .spotlight-hover {
            position: relative;
            overflow: hidden;
        }
        
        .spotlight-hover::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: radial-gradient(circle at var(--x, 50%) var(--y, 50%), rgba(255, 255, 255, 0.2) 0%, rgba(255, 255, 255, 0) 50%);
            opacity: 0;
            transition: opacity 0.3s;
            z-index: 2;
            pointer-events: none;
        }
        
        .spotlight-hover:hover::before {
            opacity: 1;
        }
        
        /* Badge styles */
        .badge-type {
            position: absolute;
            top: 1rem;
            right: 1rem;
            padding: 0.4em 0.6em;
            font-size: 0.75rem;
            font-weight: 600;
            border-radius: 20px;
            letter-spacing: 0.5px;
            z-index: 10;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }
        
        .badge-primary {
            background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
            color: white;
        }
        
        .badge-success {
            background: linear-gradient(135deg, var(--success-color), #059669);
            color: white;
        }
        
        .badge-warning {
            background: linear-gradient(135deg, var(--warning-color), #d97706);
            color: white;
        }
    </style>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/simplebar@5.3.6/dist/simplebar.min.css">
{% endblock %}

{% block content %}
<body class="bg-pattern">
    <div class="welcome-section animate-gradient" data-aos="fade-up">
        <div class="welcome-content">
            <div class="row align-items-center">
                <div class="col-auto">
                    <div class="welcome-avatar animate-pulse-shadow">
                        <i class="fas fa-robot fa-2x animate-float"></i>
                    </div>
                </div>
                <div class="col">
                    <h1 class="h3 mb-1 fw-bold">Welcome back, {{ user.username }}!</h1>
                    <p class="mb-0" style="color: rgba(255,255,255,0.8);">Build, manage and deploy powerful AI chatbots for your business</p>
                </div>
                <div class="col-auto">
                    <a href="{% url 'create_chatbot' %}" class="btn btn-light btn-lg btn-ripple spotlight-hover">
                        <i class="fas fa-plus-circle me-2"></i> Create New Chatbot
                    </a>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Stats -->
    <div class="stats-container" data-aos="fade-up" data-aos-delay="100">
        <div class="stat-card spotlight-hover" data-count="{{ chatbots|length }}">
            <span class="badge badge-type badge-primary">Bots</span>
            <div class="stat-icon spotlight-hover animate-pulse-shadow" style="background: linear-gradient(135deg, rgba(79, 70, 229, 0.1), rgba(124, 58, 237, 0.1)); color: var(--primary-color);">
                <i class="fas fa-robot"></i>
            </div>
            <div class="stat-value" id="counter-bots">0</div>
            <div class="stat-label">Total Chatbots</div>
            <div class="mt-3">
                <div class="progress">
                    <div class="progress-bar animate-gradient" role="progressbar" style="width: 100%;" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100"></div>
                </div>
            </div>
        </div>
        
        <div class="stat-card spotlight-hover" data-count="0">
            <span class="badge badge-type badge-success">Engagement</span>
            <div class="stat-icon spotlight-hover animate-pulse-shadow" style="background: linear-gradient(135deg, rgba(16, 185, 129, 0.1), rgba(5, 150, 105, 0.1)); color: var(--success-color);">
                <i class="fas fa-comment-dots"></i>
            </div>
            <div class="stat-value" id="counter-interactions">0</div>
            <div class="stat-label">Total Interactions</div>
            <div class="mt-3">
                <div class="progress">
                    <div class="progress-bar animate-gradient" style="background: linear-gradient(90deg, var(--success-color), #059669); width: 30%;" role="progressbar" aria-valuenow="30" aria-valuemin="0" aria-valuemax="100"></div>
                </div>
            </div>
        </div>
        
        <div class="stat-card spotlight-hover" data-count="{{ chatbots.0.created_at|date:'d' }}">
            <span class="badge badge-type badge-warning">Time</span>
            <div class="stat-icon spotlight-hover animate-pulse-shadow" style="background: linear-gradient(135deg, rgba(245, 158, 11, 0.1), rgba(217, 119, 6, 0.1)); color: var(--warning-color);">
                <i class="fas fa-calendar-check"></i>
            </div>
            <div class="stat-value" id="counter-days">0</div>
            <div class="stat-label">Days Active</div>
            <div class="mt-3">
                <div class="progress">
                    <div class="progress-bar animate-gradient" style="background: linear-gradient(90deg, var(--warning-color), #d97706); width: 65%;" role="progressbar" aria-valuenow="65" aria-valuemin="0" aria-valuemax="100"></div>
                </div>
            </div>
        </div>
        
        <div class="stat-card spotlight-hover" data-count="0">
            <span class="badge badge-type badge-primary" style="background: linear-gradient(135deg, var(--info-color), #0284c7);">Users</span>
            <div class="stat-icon spotlight-hover animate-pulse-shadow" style="background: linear-gradient(135deg, rgba(14, 165, 233, 0.1), rgba(2, 132, 199, 0.1)); color: var(--info-color);">
                <i class="fas fa-users"></i>
            </div>
            <div class="stat-value" id="counter-users">0</div>
            <div class="stat-label">Active Users</div>
            <div class="mt-3">
                <div class="progress">
                    <div class="progress-bar animate-gradient" style="background: linear-gradient(90deg, var(--info-color), #0284c7); width: 45%;" role="progressbar" aria-valuenow="45" aria-valuemin="0" aria-valuemax="100"></div>
                </div>
            </div>
        </div>
    </div>
      <!-- Filters -->
    <div class="filter-card spotlight-hover animate-pulse-shadow" data-aos="fade-up" data-aos-delay="150">
        <h5 class="mb-4 fw-bold d-flex align-items-center">
            <span class="icon-circle me-3">
                <i class="fas fa-filter text-primary"></i>
            </span>
            Filter & Search Chatbots
        </h5>
        
        <div class="filter-inputs">
            <div class="filter-item">
                <label for="filter-type" class="form-label">
                    <i class="fas fa-robot me-2 text-primary opacity-75"></i>Bot Type
                </label>
                <select id="filter-type" class="form-select spotlight-hover">
                    <option value="all">All Types</option>
                    <option value="text_file_based">Text File Based</option>
                    <option value="multi_question">Multi Question</option>
                    <option value="flow_based">Flow Based</option>
                </select>
            </div>
            
            <div class="filter-item">
                <label for="filter-date" class="form-label">
                    <i class="fas fa-calendar-alt me-2 text-primary opacity-75"></i>Date Created
                </label>
                <select id="filter-date" class="form-select spotlight-hover">
                    <option value="all">All Time</option>
                    <option value="today">Today</option>
                    <option value="week">This Week</option>
                    <option value="month">This Month</option>
                </select>
            </div>
            
            <div class="filter-item">
                <label for="search-bot" class="form-label">
                    <i class="fas fa-search me-2 text-primary opacity-75"></i>Search
                </label>
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="fas fa-search"></i></span>
                    <input type="text" id="search-bot" class="form-control spotlight-hover" placeholder="Search by name or type...">
                </div>
            </div>
        </div>
        
        <div class="d-flex justify-content-end mt-3">
            <button id="reset-filters" class="btn btn-sm btn-outline-secondary">
                <i class="fas fa-undo me-1"></i> Reset Filters
            </button>
        </div>
    </div>
    
    <!-- Chatbots Grid -->
    <div class="mb-4">
        <div class="d-flex align-items-center justify-content-between mb-4" data-aos="fade-up" data-aos-delay="200">
            <h4 class="fw-bold m-0 d-flex align-items-center">
                <span class="icon-circle me-3 animate-float">
                    <i class="fas fa-robot text-primary"></i>
                </span>
                Your Chatbots
                <span class="badge bg-primary ms-2 rounded-pill">{{ chatbots|length }}</span>
            </h4>
            <div>
                <button class="btn btn-sm btn-light me-2" id="view-grid">
                    <i class="fas fa-th-large"></i>
                </button>
                <button class="btn btn-sm btn-outline-light" id="view-list">
                    <i class="fas fa-list"></i>
                </button>
            </div>
        </div>
        
        <style>
            .icon-circle {
                width: 40px;
                height: 40px;
                border-radius: 50%;
                background: linear-gradient(135deg, rgba(79, 70, 229, 0.1), rgba(124, 58, 237, 0.1));
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 1.1rem;
                box-shadow: 0 4px 8px rgba(79, 70, 229, 0.15);
            }
        </style>
          {% if chatbots %}
            <div class="chatbot-grid" id="chatbot-container">
                {% for bot in chatbots %}
                <div class="chatbot-card spotlight-hover animate-fade-in-up" style="animation-delay: {{ forloop.counter|add:2 }}00ms;" data-id="{{ bot.id }}" data-type="{{ bot.chatbot_type }}" data-aos="fade-up" data-aos-delay="{{ forloop.counter|add:2 }}00">
                    <div class="chatbot-header">
                        <div class="chatbot-icon">
                            {% if bot.chatbot_type == 'text_file_based' %}
                                <i class="fas fa-file-alt"></i>
                            {% elif bot.chatbot_type == 'multi_question' %}
                                <i class="fas fa-question-circle"></i>
                            {% elif bot.chatbot_type == 'flow_based' %}
                                <i class="fas fa-project-diagram"></i>
                            {% else %}
                                <i class="fas fa-robot"></i>
                            {% endif %}
                        </div>
                        <div>
                            <h5 class="chatbot-title">{{ bot.name }}</h5>
                            <p class="chatbot-type mb-0">
                                {% if bot.chatbot_type == 'text_file_based' %}
                                    <i class="fas fa-file-alt me-1"></i>
                                {% elif bot.chatbot_type == 'multi_question' %}
                                    <i class="fas fa-question-circle me-1"></i>
                                {% elif bot.chatbot_type == 'flow_based' %}
                                    <i class="fas fa-project-diagram me-1"></i>
                                {% else %}
                                    <i class="fas fa-robot me-1"></i>
                                {% endif %}
                                {{ bot.get_chatbot_type_display }}
                            </p>
                        </div>
                        <div class="ms-auto">
                            <button onclick="deleteBot('{{ bot.id }}')" class="btn btn-sm btn-outline-danger rounded-circle btn-icon spotlight-hover" data-bs-toggle="tooltip" title="Delete bot">
                                <i class="fas fa-trash-alt"></i>
                            </button>
                        </div>
                    </div>
                    
                    <div class="chatbot-body">
                        <div class="chatbot-stats mb-4">
                            <div class="chatbot-stat">
                                <div class="chatbot-stat-value animate-counter" data-count="0">0</div>
                                <div class="chatbot-stat-label">CHATS</div>
                            </div>
                            <div class="chatbot-stat">
                                <div class="chatbot-stat-value animate-counter" data-count="0">0</div>
                                <div class="chatbot-stat-label">USERS</div>
                            </div>
                            <div class="chatbot-stat">
                                <div class="chatbot-stat-value animate-counter" data-count="0">0</div>
                                <div class="chatbot-stat-label">DAYS</div>
                            </div>
                        </div>
                        
                        <div class="d-flex align-items-center text-muted mb-4 p-2 rounded" style="background: var(--light-input-bg);">
                            <i class="fas fa-calendar-alt me-2"></i>
                            <span>Created on {{ bot.created_at|date:"M d, Y" }}</span>
                            <div class="ms-auto badge bg-light text-dark">
                                <i class="fas fa-clock me-1"></i> New
                            </div>
                        </div>
                        
                        <div class="chatbot-actions">
                            <a href="{% url 'chatbot_detail' bot.id %}" class="btn btn-primary flex-grow-1 btn-ripple spotlight-hover">
                                <i class="fas fa-eye me-2"></i>View Details
                            </a>
                            {% if bot.chatbot_type == 'text_file_based' %}
                            <a href="{% url 'multi_question_chatbot' chatbot_id=bot.id %}" class="btn btn-outline-primary btn-ripple spotlight-hover">
                                <i class="fas fa-comments"></i>
                            </a>
                            {% endif %}
                        </div>
                    </div>
                </div>
                {% endfor %}
            </div>
        {% else %}
            <div class="empty-state spotlight-hover animate-pulse-shadow" data-aos="fade-up" data-aos-delay="200">
                <div class="empty-icon spotlight-hover animate-float">
                    <i class="fas fa-robot fa-2x text-primary"></i>
                </div>
                <h3 class="mb-3 fw-bold">No Chatbots Yet</h3>
                <p class="text-muted mb-4 px-4" style="max-width: 600px; margin: 0 auto;">Create your first AI chatbot to start engaging with your users! Build intelligent conversational experiences in minutes.</p>
                <a href="{% url 'create_chatbot' %}" class="btn btn-primary btn-lg btn-ripple spotlight-hover">
                    <i class="fas fa-plus-circle me-2"></i>Create Your First Chatbot
                </a>
                
                <div class="mt-5 d-flex justify-content-center gap-4">
                    <div class="text-center">
                        <div class="mb-2">
                            <i class="fas fa-file-alt fa-2x text-primary opacity-75"></i>
                        </div>
                        <div class="fw-bold">Text Based</div>
                        <small class="text-muted">Upload documents</small>
                    </div>
                    <div class="text-center">
                        <div class="mb-2">
                            <i class="fas fa-question-circle fa-2x text-primary opacity-75"></i>
                        </div>
                        <div class="fw-bold">Multi Question</div>
                        <small class="text-muted">Create conversations</small>
                    </div>
                    <div class="text-center">
                        <div class="mb-2">
                            <i class="fas fa-project-diagram fa-2x text-primary opacity-75"></i>
                        </div>
                        <div class="fw-bold">Flow Based</div>
                        <small class="text-muted">Design complex flows</small>
                    </div>
                </div>
            </div>
        {% endif %}    </div>
    
    <!-- Quick Actions Floating Button -->
    <div class="position-fixed bottom-4 end-4" style="z-index: 1000; bottom: 2rem; right: 2rem;">
        <div class="dropdown">
            <button class="btn btn-primary btn-lg rounded-circle shadow-lg animate-pulse-shadow" type="button" id="quickActionsDropdown" data-bs-toggle="dropdown" aria-expanded="false" style="width: 60px; height: 60px; display: flex; align-items: center; justify-content: center;">
                <i class="fas fa-plus"></i>
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow-lg" aria-labelledby="quickActionsDropdown" style="border-radius: 15px; border: none; overflow: hidden;">
                <li><h6 class="dropdown-header">Quick Actions</h6></li>
                <li><a class="dropdown-item" href="{% url 'create_chatbot' %}"><i class="fas fa-robot me-2 text-primary"></i> New Chatbot</a></li>
                <li><a class="dropdown-item" href="#"><i class="fas fa-upload me-2 text-success"></i> Upload Dataset</a></li>
                <li><a class="dropdown-item" href="#"><i class="fas fa-chart-line me-2 text-info"></i> View Analytics</a></li>
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item" href="#"><i class="fas fa-question-circle me-2 text-warning"></i> Help & Support</a></li>
            </ul>
        </div>
    </div>
</body>
{% endblock %}

{% block extra_scripts %}
<script src="https://cdn.jsdelivr.net/npm/simplebar@5.3.6/dist/simplebar.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Animate counters when page loads
        setTimeout(() => {
            animateStatCounters();
            animateCardCounters();
        }, 500);
        
        // Add spotlight effect to all elements with the class
        document.querySelectorAll('.spotlight-hover').forEach(element => {
            element.addEventListener('mousemove', handleMouseMove);
        });
        
        // List/Grid view toggle
        document.getElementById('view-grid').addEventListener('click', function() {
            document.getElementById('chatbot-container').className = 'chatbot-grid';
            this.classList.add('btn-light');
            this.classList.remove('btn-outline-light');
            document.getElementById('view-list').classList.add('btn-outline-light');
            document.getElementById('view-list').classList.remove('btn-light');
        });
        
        document.getElementById('view-list').addEventListener('click', function() {
            const container = document.getElementById('chatbot-container');
            container.className = 'chatbot-list';
            this.classList.add('btn-light');
            this.classList.remove('btn-outline-light');
            document.getElementById('view-grid').classList.add('btn-outline-light');
            document.getElementById('view-grid').classList.remove('btn-light');
            
            // Add additional styles for list view
            document.head.insertAdjacentHTML('beforeend', `
                <style>
                    .chatbot-list {
                        display: flex;
                        flex-direction: column;
                        gap: 1rem;
                    }
                    
                    .chatbot-list .chatbot-card {
                        display: flex;
                        flex-direction: row;
                        height: auto;
                    }
                    
                    .chatbot-list .chatbot-header {
                        width: 25%;
                        border-bottom: none;
                        border-right: 1px solid var(--light-border);
                    }
                    
                    .chatbot-list .chatbot-body {
                        width: 75%;
                        display: flex;
                        align-items: center;
                        flex-wrap: wrap;
                    }
                    
                    .chatbot-list .chatbot-stats {
                        width: 50%;
                        margin-bottom: 0;
                        margin-right: 1rem;
                    }
                    
                    .chatbot-list .d-flex.align-items-center.text-muted {
                        width: auto;
                        margin-bottom: 0;
                        margin-right: 1rem;
                    }
                    
                    .chatbot-list .chatbot-actions {
                        margin-left: auto;
                    }
                    
                    @media (max-width: 992px) {
                        .chatbot-list .chatbot-card {
                            flex-direction: column;
                        }
                        
                        .chatbot-list .chatbot-header,
                        .chatbot-list .chatbot-body {
                            width: 100%;
                        }
                        
                        .chatbot-list .chatbot-body {
                            flex-direction: column;
                        }
                        
                        .chatbot-list .chatbot-stats,
                        .chatbot-list .d-flex.align-items-center.text-muted {
                            width: 100%;
                            margin-bottom: 1rem;
                        }
                    }
                </style>
            `);
        });
        
        // Reset filters button
        document.getElementById('reset-filters').addEventListener('click', function() {
            document.getElementById('filter-type').value = 'all';
            document.getElementById('filter-date').value = 'all';
            document.getElementById('search-bot').value = '';
            
            // Trigger change event to reset the filter
            const event = new Event('change');
            document.getElementById('filter-type').dispatchEvent(event);
        });
        
        // JavaScript to filter chatbots by type
        document.getElementById('filter-type').addEventListener('change', filterChatbots);
        document.getElementById('filter-date').addEventListener('change', filterChatbots);
        
        // Search functionality
        document.getElementById('search-bot').addEventListener('input', filterChatbots);
        
        // Initialize SimpleBar for better scrolling
        document.querySelectorAll('.filter-card, .chatbot-card').forEach(el => {
            new SimpleBar(el, { autoHide: false });
        });
        
        // Initialize tooltips
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
        var tooltipList = tooltipTriggerList.map(function(tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl);
        });
    });
    
    // Function to handle mouse move for spotlight effect
    function handleMouseMove(e) {
        const { left, top, width, height } = e.target.getBoundingClientRect();
        const x = ((e.clientX - left) / width) * 100;
        const y = ((e.clientY - top) / height) * 100;
        
        e.target.style.setProperty('--x', `${x}%`);
        e.target.style.setProperty('--y', `${y}%`);
    }
    
    // Filter chatbots based on all filter criteria
    function filterChatbots() {
        const selectedType = document.getElementById('filter-type').value;
        const selectedDate = document.getElementById('filter-date').value;
        const searchTerm = document.getElementById('search-bot').value.toLowerCase();
        const chatbotCards = document.querySelectorAll('.chatbot-card');
        
        chatbotCards.forEach(card => {
            const botName = card.querySelector('.chatbot-title').innerText.toLowerCase();
            const botType = card.querySelector('.chatbot-type').innerText.toLowerCase();
            const createdDate = card.querySelector('.d-flex.align-items-center.text-muted span').innerText;
            
            // Type filter
            const typeMatch = selectedType === 'all' || card.dataset.type === selectedType;
            
            // Date filter
            let dateMatch = true;
            if (selectedDate !== 'all') {
                const today = new Date();
                const createdAt = new Date(createdDate.replace('Created on ', ''));
                
                if (selectedDate === 'today') {
                    dateMatch = createdAt.toDateString() === today.toDateString();
                } else if (selectedDate === 'week') {
                    const weekAgo = new Date();
                    weekAgo.setDate(today.getDate() - 7);
                    dateMatch = createdAt >= weekAgo;
                } else if (selectedDate === 'month') {
                    const monthAgo = new Date();
                    monthAgo.setMonth(today.getMonth() - 1);
                    dateMatch = createdAt >= monthAgo;
                }
            }
            
            // Search term filter
            const searchMatch = botName.includes(searchTerm) || botType.includes(searchTerm);
            
            // Apply all filters
            if (typeMatch && dateMatch && searchMatch) {
                card.style.display = 'block';
            } else {
                card.style.display = 'none';
            }
        });
        
        // Show message if no results
        const visibleCards = document.querySelectorAll('.chatbot-card[style="display: block"]').length;
        const noResultsEl = document.getElementById('no-results');
        
        if (visibleCards === 0 && document.querySelectorAll('.chatbot-card').length > 0) {
            if (!noResultsEl) {
                const container = document.getElementById('chatbot-container');
                const noResults = document.createElement('div');
                noResults.id = 'no-results';
                noResults.className = 'text-center p-4 mt-3';
                noResults.innerHTML = `
                    <i class="fas fa-search fa-2x text-muted mb-3"></i>
                    <h5>No matching chatbots found</h5>
                    <p class="text-muted">Try adjusting your filters or search term</p>
                    <button id="clear-filters" class="btn btn-sm btn-outline-primary">Clear Filters</button>
                `;
                container.parentNode.insertBefore(noResults, container.nextSibling);
                
                document.getElementById('clear-filters').addEventListener('click', function() {
                    document.getElementById('reset-filters').click();
                });
            }
        } else if (noResultsEl) {
            noResultsEl.remove();
        }
    }
    
    // Animate stats at the top of the page
    function animateStatCounters() {
        document.querySelectorAll('.stat-card').forEach(card => {
            const finalValue = parseInt(card.dataset.count, 10);
            const counterElement = card.querySelector('.stat-value');
            const id = counterElement.id;
            
            animateValue(counterElement, 0, finalValue, 1500);
        });
    }
    
    // Animate counter values in chatbot cards
    function animateCardCounters() {
        document.querySelectorAll('.animate-counter').forEach(counter => {
            const finalValue = parseInt(counter.dataset.count, 10);
            animateValue(counter, 0, finalValue, 1000);
        });
    }
    
    // Animate counter from start to end value
    function animateValue(obj, start, end, duration) {
        let startTimestamp = null;
        const step = (timestamp) => {
            if (!startTimestamp) startTimestamp = timestamp;
            const progress = Math.min((timestamp - startTimestamp) / duration, 1);
            obj.innerHTML = Math.floor(progress * (end - start) + start);
            if (progress < 1) {
                window.requestAnimationFrame(step);
            }
        };
        window.requestAnimationFrame(step);
    }
    
    // Delete bot functionality
    function deleteBot(botId) {
        if (confirm('Are you sure you want to delete this chatbot?')) {
            fetch(`/delete_chatbot/${botId}/`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRFToken': getCookie('csrftoken')
                },
                body: JSON.stringify({})
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    const deletedCard = document.querySelector(`.chatbot-card[data-id="${botId}"]`);
                    deletedCard.style.transform = 'scale(0.9)';
                    deletedCard.style.opacity = '0';
                    
                    setTimeout(() => {
                        deletedCard.remove();
                        if (document.querySelectorAll('.chatbot-card').length === 0) {
                            location.reload();
                        } else {
                            // Update the stats counter
                            const statsCounter = document.querySelector('#counter-bots');
                            const newCount = parseInt(statsCounter.textContent) - 1;
                            animateValue(statsCounter, parseInt(statsCounter.textContent), newCount, 500);
                        }
                    }, 300);
                    
                    // Show success notification
                    const notification = document.createElement('div');
                    notification.className = 'position-fixed bottom-0 end-0 p-3';
                    notification.style.zIndex = '5';
                    notification.innerHTML = `
                        <div class="toast show" role="alert" aria-live="assertive" aria-atomic="true">
                            <div class="toast-header">
                                <i class="fas fa-check-circle text-success me-2"></i>
                                <strong class="me-auto">Success</strong>
                                <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
                            </div>
                            <div class="toast-body">
                                Chatbot successfully deleted.
                            </div>
                        </div>
                    `;
                    document.body.appendChild(notification);
                    
                    setTimeout(() => {
                        notification.remove();
                    }, 5000);
                }
            });
        }
    }
    
    // Get CSRF token from cookies
    function getCookie(name) {
        const value = `; ${document.cookie}`;
        const parts = value.split(`; ${name}=`);
        if (parts.length === 2) return parts.pop().split(';').shift();
    }
</script>
{% endblock %}
